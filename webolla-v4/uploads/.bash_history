package main
import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"      // Added (for reading sysfs files)
	"strconv" // Added (for converting strings to numbers)
	"strings"
)
// GpuStats holds the telemetry we care about for the Arc A770
type GpuStats struct {
	Power       string `json:"power"`        // Watts
	MemoryUsed  string `json:"memory_used"`  // MiB
	GpuUtil     string `json:"gpu_util"`     // %
	Temperature string `json:"temperature"`  // Celsius
}
// getArcTelemetry calls kernal to get live data
func getArcTelemetry() GpuStats {
	stats := GpuStats{Power: "0W", MemoryUsed: "0/0 GiB", GpuUtil: "0%"}
	// 1. Get Power (Check card0 then card1)
	powerPath := "/sys/class/drm/card0/device/hwmon/hwmon0/power1_input"
	if _, err := os.Stat(powerPath); os.IsNotExist(err) {
		powerPath = "/sys/class/drm/card1/device/hwmon/hwmon1/power1_input"
	}
	if data, err := os.ReadFile(powerPath); err == nil {
		pMicrowatts, _ := strconv.Atoi(strings.TrimSpace(string(data)))
		stats.Power = fmt.Sprintf("%.1fW", float64(pMicrowatts)/1000000.0)
	}
	// 2. Get VRAM Usage
	vramUsedPath := "/sys/class/drm/card0/device/mem_info_vram_used"
	vramTotalPath := "/sys/class/drm/card0/device/mem_info_vram_total"
	
	usedData, errU := os.ReadFile(vramUsedPath)
	totalData, errT := os.ReadFile(vramTotalPath)
	if errU == nil && errT == nil {; 		used, _ := strconv.ParseFloat(strings.TrimSpace(string(usedData)), 64)
		total, _ := strconv.ParseFloat(strings.TrimSpace(string(totalData)), 64)
		
		// Convert Bytes to GiB (1024^3)
		stats.MemoryUsed = fmt.Sprintf("%.1f / %.1f GiB", used/1073741824, total/1073741824)
	}
	return stats
}
func main() {
	// 1. Telemetry API Endpoint
	http.HandleFunc("/api/telemetry", func(w http.ResponseWriter, r *http.Request) {
		stats := getArcTelemetry()
		json.NewEncoder(w).Encode(stats)
	})
	// 2. Simple Chat Proxy to Ollama
	http.HandleFunc("/api/chat", func(w http.ResponseWriter, r *http.Request) {
		// Insert your existing Ollama proxy logic here...
		// Ensure you pass through the 'stream: true' response!
	})
	// 3. The Minimalist UI
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintf(w, `
		<html>
		<head>
			<title>Webolla ARC Edition</title>
			<style>
				body { font-family: monospace; background: #1a1a1a; color: #00ff00; padding: 20px; }
				#stats { position: fixed; top: 10; right: 10; border: 1px solid #00ff00; padding: 10px; background: #000; }
				#chat { margin-top: 50px; border-left: 2px solid #333; padding-left: 20px; }
				.metric { color: #00dbff; font-weight: bold; }
			</style>
		</head>
		<body>
			<div id="stats">
				GPU: <span id="gpu-util" class="metric">--</span> | 
				VRAM: <span id="vram" class="metric">--</span> | 
				PWR: <span id="pwr" class="metric">--</span>
			</div>
			<h1>WEBOLLA v2.0 [INTEL_ARC_A770]</h1>
			<div id="chat">...waiting for input...</div>
			<script>
				// Background Telemetry Polling (every 2 seconds)
				setInterval(async () => {
					const res = await fetch('/api/telemetry');
					const data = await res.json();
					document.getElementById('gpu-util').innerText = data.gpu_util;
					document.getElementById('vram').innerText = data.memory_used;
					document.getElementById('pwr').innerText = data.power;
				}, 2000);
			</script>
		</body>
		</html>
		
